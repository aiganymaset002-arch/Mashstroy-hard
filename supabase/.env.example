# Скопируйте в supabase/.env и заполните. Файл .env в git не попадает.
# Значения: Supabase Dashboard → Project Settings → API.

# Ссылка проекта (часть адреса https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Публичный ключ для приложения (anon / publishable)
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Секретный ключ — только для облачного шлюза и фоновых задач, никогда в приложение
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
