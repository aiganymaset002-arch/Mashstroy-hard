// Скопируйте в Config/Secrets.xcconfig и впишите значения проекта Supabase.
// Config/Secrets.xcconfig в git не попадает. Секретный service role ключ сюда не пишите.
// В xcconfig «//» начинает комментарий, поэтому адрес пишется через $(SLASH).
SLASH = /
MASHSTROY_SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR_PROJECT_REF.supabase.co
MASHSTROY_SUPABASE_ANON_KEY = YOUR_ANON_KEY
